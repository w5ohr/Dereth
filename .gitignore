# OS cruft
.DS_Store

# firecrawl research scratch (web-scrape output, session-local)
.firecrawl/

# Claude Code local (per-user) settings — keep launch.json shared, ignore local overrides
.claude/settings.local.json

# server runtime data (SQLite accounts/characters) — never commit player data
server/*.db
__pycache__/
*.pyc

# experimental single-avatar drop-in (assets/avatar.glb) stays user-supplied / ignored.
# The assets/models/ pack IS committed (self-hosted, served to clients); repopulate or
# extend it with `python3 assets/fetch-models.py`.
assets/*.glb
assets/*.gltf

# AC client data (Turbine-owned, user-supplied) — never commit
acdata/
# raw Turbine .dat source blobs anywhere (e.g. assets/client_highres.dat, 127MB) — extractor
# input only, referenced by nothing at runtime; one `git add -A` from permanent history bloat
assets/*.dat
winter-full*
winter-onset*
ace-world*.sql*
ac_data.zip
ACE-World-16PY-master/

# hi-res client source archive (extracted into acdata/; never commit the 508MB blob)
ac-updates.zip
*.zip

# local DB backups
server/*.db.bak-*
server/dereth.db
# #694: the HD texture pack is a generated artifact (tools/ac_hd_upscale.py) — never committed
assets/hd/
tools/sr_models/

# macOS Finder duplicate artifacts ("foo 2.png") — never intended to be tracked
* 2.*

# #S7 DB snapshots (backup_db) — never commit player data
server/*.bak
server/*.bak.tmp
base_srv.log
base_test.db*
spike/
